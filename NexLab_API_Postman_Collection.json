						"description": "Retrieve full list of diagnostic tests and packages."
					}
				},
				{
					"name": "Filter Tests by Category (Heart)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{base_url}}/tests?category=Heart",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"tests"
							],
							"query": [
								{
									"key": "category",
									"value": "Heart"
								}
							]
						},
						"description": "Filter tests by category: Heart, Blood, Thyroid, Energy, General."
					}
				},
				{
					"name": "Filter Packages Only",
					"request": {
						"method": "GET",
						"header": [
