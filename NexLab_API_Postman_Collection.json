								"{{base_url}}"
							],
							"path": [
								"tests"
							],
							"query": [
								{
									"key": "is_package",
									"value": "true"
								}
							]
						},
						"description": "Retrieve only health packages."
					}
				},
				{
					"name": "Search Tests",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{base_url}}/tests?search=blood",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"tests"
							],
							"query": [
								{
									"key": "search",
									"value": "blood"
								}
							]
						},
						"description": "Search diagnostic tests by name, subtitle, or description."
